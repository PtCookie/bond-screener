{
  "permissions": {
    "allow": [
      "WebFetch(domain:apis.data.go.kr)",
      "WebFetch(domain:api.cloudflare.com)",
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec astro:*)",
      "Bash(lefthook:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-generate-types.sh\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "pnpm dev *",
      "pnpm exec wrangler *"
    ],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "apis.data.go.kr",
        "api.cloudflare.com"
      ]
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
