{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-generate-types.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|Grep"
      }
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "apis.data.go.kr",
        "api.cloudflare.com"
      ]
    },
    "excludedCommands": [
      "pnpm run test*"
    ]
  }
}
