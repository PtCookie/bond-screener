{
  "permissions": {
    "allow": [
      "WebFetch(domain:apis.data.go.kr)",
      "WebFetch(domain:api.cloudflare.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec astro:*)",
      "Bash(pnpm exec wrangler:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(lefthook:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-generate-types.sh\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "apis.data.go.kr",
        "api.cloudflare.com"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "pnpm dev *",
      "pnpm test *",
      "pnpm exec wrangler *",
      "pnpm exec playwright *"
    ]
  }
}
