{
    "name": "bond-screener",
    "version": "0.0.1",
    "description": "Screener for bond in KRX",
    "keywords": [
        "Astro",
        "React",
        "TailwindCSS"
    ],
    "license": "MIT",
    "author": {
        "name": "Minsup Ju",
        "email": "me@ptcookie.net",
        "url": "https://devlog.ptcookie.net/"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "eslint",
        "format": "prettier --write .",
        "test": "vitest",
        "generate-types": "wrangler types",
        "deploy": "astro build && wrangler deploy",
        "db:migrate": "wrangler d1 migrations apply bond-screener --remote --config ./wrangler.jsonc",
        "db:migrate:local": "wrangler d1 migrations apply bond-screener --local --config ./wrangler.jsonc",
        "backfill": "node scripts/backfill.mjs",
        "snapshot": "node scripts/build-snapshot.mjs"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.1.3",
        "@astrojs/react": "^6.0.1",
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-query-devtools": "^5.101.4",
        "astro": "^7.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.17.1",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.101.4",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitest/eslint-plugin": "^1.6.23",
        "eslint": "^10.7.0",
        "eslint-plugin-astro": "^3.0.1",
        "globals": "^17.7.0",
        "jiti": "^2.7.0",
        "lefthook": "^2.1.10",
        "prettier": "3.8.3",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "shadcn": "^4.13.1",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.125.0"
    },
    "engines": {
        "node": "^22.12.0 || ^24.11.0"
    }
}
