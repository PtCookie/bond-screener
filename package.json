{
    "name": "bond-screener",
    "description": "Screener for bond in KRX",
    "keywords": [
        "Astro",
        "React",
        "TailwindCSS"
    ],
    "license": "MIT",
    "author": {
        "name": "Minsup Ju",
        "email": "me@ptcookie.net",
        "url": "https://www.ptcookie.net/"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "eslint",
        "format": "prettier --write .",
        "test": "vitest",
        "generate-types": "wrangler types",
        "deploy": "astro build && wrangler deploy",
        "db:migrate": "wrangler d1 migrations apply bond-screener --remote --config ./wrangler.jsonc",
        "db:migrate:local": "wrangler d1 migrations apply bond-screener --local --config ./wrangler.jsonc",
        "backfill": "node scripts/backfill.mjs",
        "snapshot": "node scripts/build-snapshot.mjs",
        "snapshot:local": "node scripts/build-snapshot.mjs --local",
        "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/r2",
        "seed:local": "pnpm db:migrate:local && node scripts/backfill.mjs apply --source issu --local && node scripts/backfill.mjs apply --source price --local && node scripts/backfill.mjs apply --source srtn --local && pnpm snapshot:local",
        "test:browser": "vitest --config=vitest.browser.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.4.2",
        "@astrojs/react": "^7.1.1",
        "@astrojs/sitemap": "^3.7.4",
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/newsreader": "^5.3.0",
        "@modelcontextprotocol/server": "^2.3.1",
        "@phosphor-icons/react": "^2.1.10",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-query-devtools": "^5.104.5",
        "@tanstack/react-table": "^9.3.1",
        "astro": "^7.4.2",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "lightweight-charts": "^5.2.1",
        "pretendard": "^1.3.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.6",
        "@eslint-react/eslint-plugin": "^5.28.6",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.104.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/browser-playwright": "^4.1.12",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^3.2.1",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "lefthook": "^2.2.2",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "1.1.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "shadcn": "^4.22.1",
        "typescript-eslint": "^8.72.0",
        "vitest": "^4.1.12",
        "vitest-browser-react": "^2.3.0",
        "wrangler": "^4.152.0"
    },
    "engines": {
        "node": "^22.12.0 || ^24.11.0"
    }
}
