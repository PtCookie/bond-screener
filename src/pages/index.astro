---
import Layout from "../layouts/Layout.astro";
import { BondScreener, type ScreenerDebugState } from "../components/screener/BondScreener";

const stateParam = Astro.url.searchParams.get("state");
const debugState: ScreenerDebugState = stateParam === "loading" || stateParam === "empty" ? stateParam : null;
---

<Layout title="채권 스크리너">
  <main class="mx-auto max-w-[1400px] px-4 py-6">
    <BondScreener client:load debugState={debugState} />
  </main>
</Layout>
