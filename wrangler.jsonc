{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bond-screener",
  // 커스텀 Workers 진입점. fetch는 @astrojs/cloudflare/handler의 handle에 위임하고
  // scheduled(cron)만 이 파일에서 직접 구현한다. src/worker.ts 참고.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "bond-screener.ptcookie.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // UTC 04:00-08:59 = KST 13:00-17:59. 오픈API 갱신이 "영업일+1일 오후 1시 이후"라
  // KST 13시 전에는 돌 이유가 없다. 매분 tick + sync_run 커서로 재개한다.
  // 주간 기본정보 갱신이 끝난 다음 tick에서 스크리너 스냅샷 빌드(src/lib/snapshot/build.ts)도
  // 이 창 안에서 자동 실행된다 — 별도 cron 항목 불필요(src/lib/sync/plan.ts의 "snapshot" 액션 참고).
  "triggers": {
    "crons": ["*/1 4-8 * * *"],
  },
  // `limits.cpu_ms`는 의도적으로 설정하지 않는다. 미설정 시 기본값(1시간 미만 간격
  // cron은 30초)이 이미 이 파이프라인의 CPU 사용량(페이지당 ~12ms, 스냅샷 빌드
  // 실측 ~90ms)에 충분하고, 명시하면 오히려 "1시간 이상 간격 cron은 기본 15분"인
  // 상한을 낮은 값으로 깎아버리는 부작용이 있다(향후 cron 표현식을 넓은 간격으로
  // 바꿀 일이 생기면 그때 다시 검토할 것).
  // `/api/bond/*`가 D1을 직접 때리는 라우트를 IP당 요청 수로 보호한다. namespace_id는
  // 사전에 생성할 리소스가 아니라 계정 내에서 임의로 고유하게 붙이는 식별자다.
  "ratelimits": [
    {
      "name": "BOND_API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bond-screener",
      "database_id": "3290c60b-965b-40ba-b1fe-1a31937e20e4",
      "migrations_dir": "migrations",
    },
  ],
  // `wrangler r2 bucket create bond-screener-archive` 실행 후에는 별도 ID 기입 불필요(이름으로 바인딩).
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "bond-screener-archive",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
